    function positionGuide(element, centerX, centerY, boxW, boxH, wallW, wallH, editorW, editorH) {
        element.style.width = `${boxW / editorW * 100}%`;
        element.style.height = `${boxH / editorH * 100}%`;
        element.style.left = `${(centerX + wallW * EDITOR_MARGIN_X) / editorW * 100 - boxW / editorW * 50}%`;
        element.style.top = `${(centerY + wallH * EDITOR_MARGIN_Y) / editorH * 100 - boxH / editorH * 50}%`;
    }

    function updateSurfaceGuides(wallW, wallH, editorW, editorH) {
        positionGuide(document.getElementById('ledWallGuide'), wallW / 2, wallH / 2, wallW, wallH, wallW, wallH, editorW, editorH);
        for (const role of ['ceiling', 'floor']) {
            const preset = SURFACE_PRESETS[role];
            const centerX = wallW / 2 + preset.x * BASE_WIDTH;
            const boxW = preset.scale * BASE_WIDTH;
            const boxH = boxW * preset.ih / preset.iw;
            const centerY = role === 'ceiling' ? -boxH / 2 : wallH + boxH / 2;
            positionGuide(document.getElementById(`${role}Guide`), centerX, centerY, boxW, boxH, wallW, wallH, editorW, editorH);
        }
    }

    function renderMultiLayerPreview() {
        elVisualizer.querySelectorAll('.multi-preview-source').forEach(el => el.remove());
        if (selectedLayers.size <= 1) return;
        const wallW = Number(lwInput.value) || 1, wallH = Number(lhInput.value) || 1;
        const editorW = wallW * EDITOR_SCALE_X, editorH = wallH * EDITOR_SCALE_Y;
        selectedLayers.forEach(layer => {
            if (layer === currentSelectedLayer) return;
            const state = layerStates[layer];
            if (!state) return;
            const sourceW = Number(state.iw) || 1, sourceH = Number(state.ih) || 1;
            const scale = Number(state.scaleValue) || 1, scaleH = Number(state.scaleHeight) || 1;
            const boxW = scale * BASE_WIDTH, boxH = scale * scaleH * BASE_WIDTH * (sourceH / sourceW);
            const previewCenter = getPreviewCenter(state, wallH);
            const box = document.createElement('div');
            box.className = 'multi-preview-source';
            box.style.width = `${boxW / editorW * 100}%`;
            box.style.height = `${boxH / editorH * 100}%`;
            box.style.left = `${(previewCenter.x + wallW * EDITOR_MARGIN_X) / editorW * 100 - boxW / editorW * 50}%`;
            box.style.top = `${(previewCenter.y + wallH * EDITOR_MARGIN_Y) / editorH * 100 - boxH / editorH * 50}%`;
            box.style.transform = `rotate(${Number(state.rotationValue) || 0}deg)`;
            const blur = state.edgeBlurEnabled ? Number(state.edgeBlurStrength) || 0 : 0;
            if (blur) box.style.boxShadow = `inset 0 0 ${Math.max(3, blur * .22)}px rgba(241,245,249,.75)`;
            const name = document.createElement('span');
            name.className = 'source-layer-name'; name.textContent = getPreviewLayerLabel(layer);
            box.appendChild(name);
            elVisualizer.appendChild(box);
            fitPreviewLayerLabel(name, layer, box);
        });
    }

    document.querySelectorAll(".snap-btn").forEach(btn => btn.addEventListener("click", function() {
        document.querySelectorAll(".snap-btn").forEach(b => b.classList.remove("active"));
        this.classList.add("active");
        setSnapPosition(this);
        updateAll(); captureState(); saveCurrentLayerState(); 
    }));

    let transformGesture = null;

    function pointerToWall(e, rect, lw, lh) {
        return {
            x: (e.clientX - rect.left) * (lw * EDITOR_SCALE_X) / rect.width - lw * EDITOR_MARGIN_X,
            y: (e.clientY - rect.top) * (lh * EDITOR_SCALE_Y) / rect.height - lh * EDITOR_MARGIN_Y
        };
    }

    function finishTransformGesture(e) {
        if (!transformGesture || (e.pointerId !== undefined && e.pointerId !== transformGesture.pointerId)) return;
        if (transformGesture.moved) {
            updateAll(true);
            saveCurrentLayerState();
            captureState();
        }
        elSourceBox.classList.remove("is-transforming");
        transformGesture = null;
    }

    elSourceBox.addEventListener("pointerdown", (e) => {
        if (e.button !== 0 || e.target.closest('.source-handle')) return;
        transformGesture = {
            type: 'move', pointerId: e.pointerId, startClientX: e.clientX, startClientY: e.clientY,
            startX: Number(pixelXInput.value), startY: Number(pixelYInput.value), moved: false
        };
        elSourceBox.setPointerCapture(e.pointerId);
        elSourceBox.classList.add("is-transforming");
        e.preventDefault();
    });

    document.querySelectorAll('.source-handle').forEach(handle => {
        handle.addEventListener('pointerdown', (e) => {
            if (e.button !== 0) return;
            e.stopPropagation(); e.preventDefault();
            const rect = elVisualizer.getBoundingClientRect();
            const lw = Number(lwInput.value) || 1, lh = Number(lhInput.value) || 1;
            const serverCenterX = Number(pixelXInput.value), serverCenterY = Number(pixelYInput.value);
            const previewCenter = getPreviewCenter({ ...layerStates[currentSelectedLayer], pixelX: serverCenterX, pixelY: serverCenterY }, lh);
            const centerX = previewCenter.x, centerY = previewCenter.y;
            const rotation = Number(rotationInput.value) || 0;
            const startPoint = pointerToWall(e, rect, lw, lh);
            const handleName = handle.dataset.handle;
            transformGesture = {
                type: handleName === 'rotate' ? 'rotate' : 'resize', handle: handleName,
                pointerId: e.pointerId, rect, lw, lh, centerX, centerY, rotation,
                serverCenterX, serverCenterY,
                startPointerAngle: Math.atan2(startPoint.y - centerY, startPoint.x - centerX),
                startW: (parseFloat(scaleInput.value) || 1) * BASE_WIDTH,
                startH: (parseFloat(scaleInput.value) || 1) * (parseFloat(scaleHeightInput.value) || 1) * BASE_WIDTH * (Number(ihInput.value) / Number(iwInput.value)),
                moved: false
            };
            handle.setPointerCapture(e.pointerId);
            elSourceBox.classList.add("is-transforming");
        });
    });

    window.addEventListener("pointermove", (e) => {
        const g = transformGesture;
        if (!g || e.pointerId !== g.pointerId) return;
        g.moved = true;
        document.querySelectorAll(".snap-btn").forEach(b => b.classList.remove("active"));

        if (g.type === 'move') {
            const rect = elVisualizer.getBoundingClientRect();
            const lw = Number(lwInput.value) || 1, lh = Number(lhInput.value) || 1;
            pixelXInput.value = Math.round(g.startX + (e.clientX - g.startClientX) * lw * EDITOR_SCALE_X / rect.width);
            pixelYInput.value = Math.round(g.startY + (e.clientY - g.startClientY) * lh * EDITOR_SCALE_Y / rect.height);
        } else if (g.type === 'rotate') {
            const point = pointerToWall(e, g.rect, g.lw, g.lh);
            const angle = Math.atan2(point.y - g.centerY, point.x - g.centerX);
            let degrees = g.rotation + (angle - g.startPointerAngle) * 180 / Math.PI;
            if (e.shiftKey) degrees = Math.round(degrees / 15) * 15;
            rotationInput.value = ((degrees % 360) + 360) % 360 < 0.05 ? 0 : (((degrees % 360) + 360) % 360).toFixed(1);
        } else {
            const point = pointerToWall(e, g.rect, g.lw, g.lh);
            const theta = -g.rotation * Math.PI / 180;
            const dx = point.x - g.centerX, dy = point.y - g.centerY;
            const localX = dx * Math.cos(theta) - dy * Math.sin(theta);
            const localY = dx * Math.sin(theta) + dy * Math.cos(theta);
            const map = { nw:[-1,-1], n:[0,-1], ne:[1,-1], e:[1,0], se:[1,1], s:[0,1], sw:[-1,1], w:[-1,0] };
            const [sx, sy] = map[g.handle];
            const minSize = 24;
            let newW = g.startW, newH = g.startH, shiftX = 0, shiftY = 0;
            if (sx) {
                const oppositeX = -sx * g.startW / 2;
                newW = Math.max(minSize, sx * (localX - oppositeX));
                shiftX = (oppositeX + oppositeX + sx * newW) / 2;
            }
            if (sy) {
                const oppositeY = -sy * g.startH / 2;
                newH = Math.max(minSize, sy * (localY - oppositeY));
                shiftY = (oppositeY + oppositeY + sy * newH) / 2;
            }
            if (scaleHeightInput.disabled && sx && sy) {
                const factor = Math.max(newW / g.startW, newH / g.startH);
                newW = g.startW * factor; newH = g.startH * factor;
            } else if (scaleHeightInput.disabled && sx) newH = newW * (g.startH / g.startW);
            else if (scaleHeightInput.disabled && sy) newW = newH * (g.startW / g.startH);
            else if (e.shiftKey && sx && sy) {
                const factor = Math.max(newW / g.startW, newH / g.startH);
                newW = g.startW * factor; newH = g.startH * factor;
            }
            shiftX = sx ? sx * (newW - g.startW) / 2 : 0;
            shiftY = sy ? sy * (newH - g.startH) / 2 : 0;
            const forward = g.rotation * Math.PI / 180;
            const worldShiftX = shiftX * Math.cos(forward) - shiftY * Math.sin(forward);
            const worldShiftY = shiftX * Math.sin(forward) + shiftY * Math.cos(forward);
            pixelXInput.value = Math.round(g.serverCenterX + worldShiftX);
            pixelYInput.value = Math.round(g.serverCenterY + worldShiftY);
            scaleInput.value = (newW / BASE_WIDTH).toFixed(6);
            scaleHeightInput.value = scaleHeightInput.disabled ? "1.000000" : (newH / (newW * (Number(ihInput.value) / Number(iwInput.value)))).toFixed(6);
        }
        updateAll(true);
    });

    window.addEventListener("pointerup", finishTransformGesture);
    window.addEventListener("pointercancel", finishTransformGesture);

    document.querySelectorAll('.rotation-preset').forEach(btn => btn.addEventListener('click', () => {
        rotationInput.value = btn.dataset.rotation;
        updateAll(); saveCurrentLayerState(); captureState();
    }));

    function evaluateArithmetic(expression) {
        const source = expression.replace(/,/g, '').replace(/\s+/g, '');
        let index = 0;
        function parseNumber() {
            const start = index;
            while (index < source.length && /[0-9.]/.test(source[index])) index++;
            if (start === index) throw new Error('숫자가 필요합니다.');
            const value = Number(source.slice(start, index));
            if (!Number.isFinite(value)) throw new Error('올바른 숫자가 아닙니다.');
            return value;
        }
        function parseFactor() {
            if (source[index] === '+') { index++; return parseFactor(); }
            if (source[index] === '-') { index++; return -parseFactor(); }
            if (source[index] === '(') {
                index++; const value = parseExpression();
                if (source[index] !== ')') throw new Error('괄호를 닫아주세요.');
                index++; return value;
            }
            return parseNumber();
        }
        function parseTerm() {
            let value = parseFactor();
            while (source[index] === '*' || source[index] === '/') {
                const operator = source[index++], right = parseFactor();
                if (operator === '/' && right === 0) throw new Error('0으로 나눌 수 없습니다.');
                value = operator === '*' ? value * right : value / right;
            }
            return value;
        }
        function parseExpression() {
            let value = parseTerm();
            while (source[index] === '+' || source[index] === '-') {
                const operator = source[index++], right = parseTerm();
                value = operator === '+' ? value + right : value - right;
            }
            return value;
        }
        if (!source) throw new Error('값이나 수식을 입력하세요.');
        const value = parseExpression();
        if (index !== source.length || !Number.isFinite(value)) throw new Error('수식을 확인해주세요.');
        return value;
    }

    function getTransformValue(key) {
        if (key === 'posX') return Number(document.getElementById('posX_result').innerText);
        if (key === 'posY') return Number(document.getElementById('posY_result').innerText);
        return Number(document.getElementById(key).value) || 0;
    }

    function applyTransformValue(key, value) {
        if (!Number.isFinite(value)) return;
        if (key === 'posX') pixelXInput.value = Math.round(value * BASE_WIDTH + Number(lwInput.value) / 2);
        else if (key === 'posY') pixelYInput.value = Math.round(Number(lhInput.value) / 2 - value * BASE_WIDTH);
        else if (key === 'rotationValue') rotationInput.value = Number((((value % 360) + 360) % 360).toFixed(3));
        else document.getElementById(key).value = ['pixelX','pixelY'].includes(key) ? Math.round(value) : value.toFixed(6);
        document.querySelectorAll(".snap-btn").forEach(b => b.classList.remove("active"));
        updateAll(); saveCurrentLayerState(); captureState();
    }

    let expressionPopover = null;
    function closeExpressionPopover() {
        if (expressionPopover) expressionPopover.remove();
        expressionPopover = null;
    }

    function openExpressionPopover(e, field) {
        closeExpressionPopover();
        const key = field.dataset.transform, current = getTransformValue(key);
        const popover = document.createElement('div');
        popover.className = 'expression-popover';
        popover.innerHTML = `<div class="expression-title">${field.dataset.label} · 숫자/수식 입력</div><input type="text" aria-label="${field.dataset.label} 수식" value="${current}"><div class="expression-hint">직접값: 100 &nbsp; 상대계산: +10, -10, *2, /2<br>일반수식: 100+20*2 &nbsp; 음수 직접값: =-10</div>`;
        document.body.appendChild(popover);
        const left = Math.min(e.clientX, window.innerWidth - 255), top = Math.min(e.clientY, window.innerHeight - 125);
        popover.style.left = `${Math.max(8, left)}px`; popover.style.top = `${Math.max(8, top)}px`;
        expressionPopover = popover;
        const input = popover.querySelector('input');
        input.focus(); input.select();
        const submit = () => {
            try {
                let raw = input.value.trim(), value;
                if (/^[+\-*/]/.test(raw) && !raw.startsWith('=')) value = evaluateArithmetic(`${current}${raw}`);
                else value = evaluateArithmetic(raw.startsWith('=') ? raw.slice(1) : raw);
                applyTransformValue(key, value); closeExpressionPopover();
            } catch (error) {
                const hint = popover.querySelector('.expression-hint');
                hint.classList.add('expression-error'); hint.textContent = error.message;
                input.focus(); input.select();
            }
        };
        input.addEventListener('keydown', event => {
            if (event.key === 'Enter') { event.preventDefault(); submit(); }
            if (event.key === 'Escape') closeExpressionPopover();
        });
        input.addEventListener('blur', () => setTimeout(() => { if (expressionPopover === popover) closeExpressionPopover(); }, 120));
    }

    document.querySelectorAll('.transform-field').forEach(field => field.addEventListener('contextmenu', e => {
        if (e.target.closest('.rotation-preset')) { e.preventDefault(); e.stopPropagation(); return; }
        e.preventDefault(); e.stopPropagation(); openExpressionPopover(e, field);
    }));
    document.querySelectorAll('.rotation-preset').forEach(button => button.addEventListener('contextmenu', e => {
        e.preventDefault(); e.stopPropagation();
    }));

    let lockContextMenu = null;
    function closeLockContextMenu() {
        if (lockContextMenu) lockContextMenu.remove();
        lockContextMenu = null;
    }
    document.getElementById('scaleHeightField').addEventListener('contextmenu', e => {
        e.preventDefault(); e.stopPropagation(); closeExpressionPopover(); closeLockContextMenu();
        const menu = document.createElement('div');
        menu.className = 'lock-context-menu';
        if (scaleHeightInput.disabled) {
            const unlock = document.createElement('button');
            unlock.textContent = '🔓 잠금 해제';
            unlock.onclick = () => {
                updateScaleHeightLockUI(false); saveCurrentLayerState(); captureState(); closeLockContextMenu(); scaleHeightInput.focus();
            };
            menu.appendChild(unlock);
        } else {
            const edit = document.createElement('button'); edit.textContent = '⌨ 숫자·수식 입력';
            edit.onclick = () => { closeLockContextMenu(); openExpressionPopover(e, document.getElementById('scaleHeightField')); };
            const lock = document.createElement('button'); lock.textContent = '🔒 1로 재설정 후 잠금';
            lock.onclick = () => {
                scaleHeightInput.value = '1.000000'; updateScaleHeightLockUI(true); updateAll(); saveCurrentLayerState(); captureState(); closeLockContextMenu();
            };
            menu.append(edit, lock);
        }
        document.body.appendChild(menu);
        menu.style.left = `${Math.min(e.clientX, window.innerWidth - 200)}px`;
        menu.style.top = `${Math.min(e.clientY, window.innerHeight - menu.offsetHeight - 8)}px`;
        lockContextMenu = menu;
    });
    document.addEventListener('pointerdown', e => {
        if (expressionPopover && !expressionPopover.contains(e.target)) closeExpressionPopover();
        if (lockContextMenu && !lockContextMenu.contains(e.target)) closeLockContextMenu();
    });

    inputsToTrack.forEach(id => {
        const el = document.getElementById(id);
        if(el) { 
            el.addEventListener("input", () => {
                if (['iw', 'ih', 'lw', 'lh'].includes(id)) handleResolutionChange();
                else updateAll();
            }); 
            el.addEventListener("change", () => { captureState(); saveCurrentLayerState(); }); 
        }
    });

    document.getElementById("scaleValue").addEventListener("blur", function() { forceDecimalFormat(this.id); });
    document.getElementById("scaleHeight").addEventListener("blur", function() { if (!this.disabled) forceDecimalFormat(this.id); });
    document.getElementById("rotationValue").addEventListener("blur", function() {
        let value = Number(this.value) || 0;
        value = ((value % 360) + 360) % 360;
        this.value = Number(value.toFixed(1));
        updateAll(); saveCurrentLayerState();
    });
    presetSelect.addEventListener("change", () => applyPreset(true));

    window.onload = () => {
        loadLayerState(1); applyPreset(false); captureState();
        makeScrubbable('scaleValue', 'scaleValue', 0.002, false);
        makeScrubbable('pixelX', 'pixelX', 10, true);
        makeScrubbable('pixelY', 'pixelY', 10, true);
        makeScrubbable('posX_wrapper', 'pixelX', 10, true);
        makeScrubbable('posY_wrapper', 'pixelY', 10, true);
        requestAnimationFrame(syncLayerPanelHeight);
    };
    window.addEventListener('resize', () => {
        syncLayerPanelHeight();
        updateAll(false);
    });
</script>
</body>
</html>
