<script>
    const BASE_WIDTH = 11520;
    const MAX_LAYERS = 50;
    const EDITOR_SCALE_X = 1.5;
    const EDITOR_SCALE_Y = 2.5;
    const EDITOR_MARGIN_X = (EDITOR_SCALE_X - 1) / 2;
    const EDITOR_MARGIN_Y = (EDITOR_SCALE_Y - 1) / 2;
    const SURFACE_PRESETS = Object.freeze({
        ceiling: { iw: 1920, ih: 1080, x: 0.01000, y: 0.34437, scale: 0.34000 },
        floor: { iw: 1920, ih: 1080, x: 0.00000, y: -0.39779, scale: 0.33000 }
    });
    const DEFAULT_LAYER_STATE = Object.freeze({
        iw: "3840", ih: "2160", scaleValue: "0.333333", scaleHeight: "1.000000", scaleHeightLocked: true, rotationValue: "0",
        pixelX: "4608", pixelY: "1836", ledPreset: "9216,3672", lw: "9216", lh: "3672",
        scanName: "", scanExt: "", scanW: 0, scanH: 0, edgeBlurEnabled: false, edgeBlurStrength: "20", surfaceRole: "main"
    });
    function getMainTransformSnapshot(state) {
        return {
            iw: state.iw, ih: state.ih, scaleValue: state.scaleValue, scaleHeight: state.scaleHeight,
            scaleHeightLocked: state.scaleHeightLocked, rotationValue: state.rotationValue,
            pixelX: state.pixelX, pixelY: state.pixelY
        };
    }
    function createDefaultLayerState() {
        const state = { ...DEFAULT_LAYER_STATE };
        state.mainTransform = getMainTransformSnapshot(state);
        return state;
    }
    let currentSelectedLayer = 1;
    let selectedLayers = new Set([1]);
    let selectionAnchorLayer = 1;

    const layerStates = {}; 

    let undoStack = [];
    let redoStack = [];
    let isHistoryAction = false;
    let isGlobalScrubbing = false; 
    
    const UNDO_LIMIT = 30;
    const inputsToTrack = ["iw", "ih", "scaleValue", "scaleHeight", "rotationValue", "pixelX", "pixelY", "ledPreset", "lw", "lh", "edgeBlurStrength"];
    
    const iwInput = document.getElementById("iw"), ihInput = document.getElementById("ih");
    const lwInput = document.getElementById("lw"), lhInput = document.getElementById("lh");
    const scaleInput = document.getElementById("scaleValue"), scaleHeightInput = document.getElementById("scaleHeight");
    const rotationInput = document.getElementById("rotationValue");
    const pixelXInput = document.getElementById("pixelX"), pixelYInput = document.getElementById("pixelY");
    const presetSelect = document.getElementById("ledPreset");
    const edgeBlurEnabledInput = document.getElementById("edgeBlurEnabled"), edgeBlurStrengthInput = document.getElementById("edgeBlurStrength");
    const edgeBlurValue = document.getElementById("edgeBlurValue"), edgeBlurPreview = document.getElementById("edgeBlurPreview");
    const elSourceBox = document.getElementById("sourceBox"), elVisualizer = document.getElementById("visualizer");
    const sourceResLabel = document.getElementById("sourceResLabel"), calcResLabel = document.getElementById("calcResLabel"), sourceLayerName = document.getElementById("sourceLayerName");
    const layerList = document.getElementById("layerList");
    const previewLayerName = document.getElementById("previewLayerName");
    const normalLeftPanel = document.getElementById("normalLeftPanel"), autoSplitPanel = document.getElementById("autoSplitPanel");
    const splitPreview = document.getElementById("splitPreview"), splitSettings = document.getElementById("splitSettings"), splitError = document.getElementById("splitError");
    
    const undoBtn = document.getElementById("undoBtn"), redoBtn = document.getElementById("redoBtn"), resetBtn = document.getElementById("resetBtn");

    const layerNames = {}; 

    function getPreviewLayerLabel(layer) {
        const rawName = String(layerNames[layer] || '').trim();
        const withoutDefaultPrefix = rawName.replace(new RegExp(`^Layer\\s*${layer}(?:\\s+|$)`, 'i'), '').trim();
        return withoutDefaultPrefix ? `${layer} ${withoutDefaultPrefix}` : String(layer);
    }

    function fitPreviewLayerLabel(element, layer, sourceElement) {
        const fullLabel = getPreviewLayerLabel(layer);
        const availableWidth = Math.max(0, sourceElement.clientWidth - 12);
        element.classList.remove('number-only');
        element.textContent = fullLabel;
        element.title = fullLabel;
        element.style.maxWidth = `${availableWidth}px`;
        const fullWidth = element.scrollWidth;
        if (availableWidth < 18 || fullWidth > availableWidth * 1.45) {
            element.textContent = String(layer);
            element.classList.add('number-only');
            element.style.maxWidth = 'none';
        }
    }

    function updatePrimarySourceTextVisibility() {
        const width = elSourceBox.clientWidth, height = elSourceBox.clientHeight;
        const hideResolution = width < 112 || height < 50;
        sourceResLabel.classList.toggle('source-resolution-hidden', hideResolution);
        calcResLabel.classList.toggle('source-resolution-hidden', hideResolution);
        fitPreviewLayerLabel(sourceLayerName, currentSelectedLayer, elSourceBox);
    }

    // ✅ 스마트 스캐너 전역 변수
    const dropZone = document.getElementById('mediaDropZone');
    const scanDefaultState = document.getElementById('scanDefaultState');
    const scanActiveState = document.getElementById('scanActiveState');
    const scanNameEl = document.getElementById('scanName');
    const scanExtEl = document.getElementById('scanExt');
    const scanResEl = document.getElementById('scanRes');
    const applyScanBtn = document.getElementById('applyScanBtn');

    let tempScannedName = "";
    let tempScannedExt = "";
    let tempScannedW = 0;
    let tempScannedH = 0;

    // 💡 마우스 호버 시 오버레이 클래스 제어
    dropZone.addEventListener('mouseenter', () => {
        dropZone.classList.add('active-overlay');
    });
    dropZone.addEventListener('mouseleave', () => {
        dropZone.classList.remove('active-overlay');
    });

    // 💡 드래그 시 시각적 일관성 확보
    dropZone.addEventListener('dragover', (e) => { 
        e.preventDefault(); 
        dropZone.classList.add('dragover'); 
        dropZone.classList.add('active-overlay'); // 💡 드래그 중에도 오버레이 표시
    });
    dropZone.addEventListener('dragleave', () => { 
        dropZone.classList.remove('dragover'); 
        dropZone.classList.remove('active-overlay');
    });
    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        dropZone.classList.remove('active-overlay');
        const file = e.dataTransfer.files[0];
        if (file) processMediaFile(file);
    });

    // 💡 클릭 시 탐색기 창이 뜨는 동안 오버레이를 즉시 제거하여 기존 정보가 보이게 함
    dropZone.addEventListener('click', () => {
        dropZone.classList.remove('active-overlay'); // 💡 즉시 제거!
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = 'video/*, image/*';
        input.onchange = (e) => {
            if(e.target.files[0]) processMediaFile(e.target.files[0]);
        };
        input.click();
    });

    function processMediaFile(file) {
        const extMatch = file.name.match(/\.([a-z0-9]+)$/i);
        const ext = extMatch ? extMatch[1].toLowerCase() : "";
        const isVideo = file.type.startsWith('video/') || ['mp4', 'mov', 'avi', 'mkv', 'webm'].includes(ext);
        const isImage = file.type.startsWith('image/') || ['jpg', 'jpeg', 'png', 'gif', 'webp', 'bmp'].includes(ext);
        const fileURL = URL.createObjectURL(file);

        if (isVideo) {
            const video = document.createElement('video');
            video.src = fileURL;
            video.onloadedmetadata = () => {
                updateScanUI(file.name, ext, video.videoWidth, video.videoHeight);
                URL.revokeObjectURL(fileURL);
            };
            video.onerror = () => { alert('영상을 로드할 수 없습니다.'); };
        } else if (isImage) {
            const img = new Image();
            img.src = fileURL;
            img.onload = () => {
                updateScanUI(file.name, ext, img.naturalWidth, img.naturalHeight);
                URL.revokeObjectURL(fileURL);
            };
            img.onerror = () => { alert('이미지를 로드할 수 없습니다.'); };
        } else {
            alert('지원하지 않는 파일 형식입니다.');
        }
    }

    function updateScanUI(fileName, ext, width, height) {
        tempScannedName = fileName;
        tempScannedExt = ext;
        tempScannedW = width;
        tempScannedH = height;

        scanDefaultState.style.display = 'none';
        scanActiveState.style.display = 'flex';

        let nameOnly = fileName;
        if(ext) {
            const regex = new RegExp('\\.' + ext + '$', 'i');
            nameOnly = fileName.replace(regex, '');
        }

        scanNameEl.innerText = nameOnly;
        scanNameEl.title = fileName; 
        scanExtEl.innerText = ext ? ext.toUpperCase() : "UNKNOWN";
        scanResEl.innerText = `${width} × ${height}`; 
        
        checkScanAppliedState();
        saveCurrentLayerState(); 
    }

    function resetScanUI() {
        tempScannedName = ""; tempScannedExt = ""; tempScannedW = 0; tempScannedH = 0;
        scanDefaultState.style.display = 'flex';
        scanActiveState.style.display = 'none';
    }

    function checkScanAppliedState() {
        if (tempScannedW > 0 && tempScannedH > 0) {
            const currentIw = Number(iwInput.value);
            const currentIh = Number(ihInput.value);
            
            if (currentIw === tempScannedW && currentIh === tempScannedH) {
                applyScanBtn.disabled = true; 
                applyScanBtn.innerHTML = `✅ 해상도 적용됨 ✅`;
            } else {
                applyScanBtn.disabled = false;
                applyScanBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> 해상도 적용`;
            }
        }
    }

    applyScanBtn.addEventListener('click', () => {
        if(tempScannedW === 0 || tempScannedH === 0) return;
        iwInput.value = tempScannedW;
        ihInput.value = tempScannedH;
        handleResolutionChange();
        captureState();
        saveCurrentLayerState();
    });

    function saveCurrentLayerState() {
        const scaleHeightLocked = scaleHeightInput.disabled;
        if (scaleHeightLocked) scaleHeightInput.value = "1.000000";
        const previous = layerStates[currentSelectedLayer] || DEFAULT_LAYER_STATE;
        const surfaceRole = previous.surfaceRole || "main";
        const currentTransform = {
            iw: iwInput.value, ih: ihInput.value, scaleValue: scaleInput.value, scaleHeight: scaleHeightInput.value,
            scaleHeightLocked, rotationValue: rotationInput.value, pixelX: pixelXInput.value, pixelY: pixelYInput.value
        };
        layerStates[currentSelectedLayer] = {
            iw: iwInput.value, ih: ihInput.value,
            scaleValue: scaleInput.value, scaleHeight: scaleHeightInput.value, scaleHeightLocked, rotationValue: rotationInput.value,
            pixelX: pixelXInput.value, pixelY: pixelYInput.value,
            ledPreset: presetSelect.value, lw: lwInput.value, lh: lhInput.value,
            scanName: tempScannedName, scanExt: tempScannedExt, scanW: tempScannedW, scanH: tempScannedH,
            edgeBlurEnabled: edgeBlurEnabledInput.checked, edgeBlurStrength: edgeBlurStrengthInput.value,
            surfaceRole,
            mainTransform: surfaceRole === "main" ? currentTransform : previous.mainTransform
        };
    }

    function loadLayerState(num) {
        const state = layerStates[num];
        if (!state) return;
        iwInput.value = state.iw; ihInput.value = state.ih;
        scaleInput.value = state.scaleValue;
        scaleHeightInput.value = state.scaleHeightLocked === false ? (state.scaleHeight || "1.000000") : "1.000000";
        updateScaleHeightLockUI(state.scaleHeightLocked !== false);
        rotationInput.value = state.rotationValue ?? "0";
        pixelXInput.value = state.pixelX; pixelYInput.value = state.pixelY;
        presetSelect.value = state.ledPreset; lwInput.value = state.lw; lhInput.value = state.lh;
        edgeBlurEnabledInput.checked = Boolean(state.edgeBlurEnabled);
        edgeBlurStrengthInput.value = state.edgeBlurStrength ?? "20";
        updateEdgeBlurUI(false);
        state.surfaceRole = state.surfaceRole || "main";
        updateSurfaceButtonStates();
        if (presetSelect.value) { lwInput.disabled = true; lhInput.disabled = true; } 
        else { lwInput.disabled = false; lhInput.disabled = false; }

        if (state.scanW && state.scanW > 0) {
            updateScanUI(state.scanName, state.scanExt, state.scanW, state.scanH);
        } else {
            resetScanUI();
        }
    }

    window.copyInput = function(inputId, labelText) {
        if (isGlobalScrubbing) return; 
        const input = document.getElementById(inputId);
        navigator.clipboard.writeText(input.value);
        const label = input.previousElementSibling;
        label.classList.add("copied-label"); label.innerText = "Copied!";
        setTimeout(() => { label.classList.remove("copied-label"); label.innerText = labelText; }, 800);
    };

    function forceDecimalFormat(elId) {
        const el = document.getElementById(elId);
        let val = parseFloat(el.value);
        if (!isNaN(val)) { el.value = val.toFixed(6); saveCurrentLayerState(); }
    }

    function makeScrubbable(elId, targetInputId, stepMultiplier, isInt) {
        const triggerEl = document.getElementById(elId);
        if (!triggerEl) return;
        triggerEl.style.cursor = 'ns-resize';
        triggerEl.title = "위아래로 드래그하여 조절 (Shift: 미세조절)";
        let isDown = false, scrubbing = false, startY = 0, startVal = 0;
        triggerEl.addEventListener('mousedown', (e) => {
            isDown = true; scrubbing = false; startY = e.clientY;
            startVal = parseFloat(document.getElementById(targetInputId).value) || 0;
        });
        window.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            let deltaY = startY - e.clientY; 
            if (!scrubbing && Math.abs(deltaY) > 3) {
                scrubbing = true; isGlobalScrubbing = true; document.body.style.userSelect = 'none'; 
            }
            if (scrubbing) {
                let currentStep = e.shiftKey ? stepMultiplier * 0.1 : stepMultiplier;
                let newVal = startVal + (deltaY * currentStep);
                if (isInt) newVal = Math.round(newVal); else newVal = Number(newVal).toFixed(6); 
                document.getElementById(targetInputId).value = newVal;
                document.querySelectorAll(".snap-btn").forEach(b => b.classList.remove("active"));
                updateAll();
            }
        });
        window.addEventListener('mouseup', () => {
            if (isDown && scrubbing) {
                document.body.style.userSelect = ''; 
                saveCurrentLayerState(); captureState(); 
                setTimeout(() => { isGlobalScrubbing = false; }, 50); 
            }
            isDown = false; scrubbing = false;
        });
    }

    function captureState() {
        if (isHistoryAction) return;
        const state = { layer: currentSelectedLayer, names: { ...layerNames }, values: {}, edgeBlurEnabled: edgeBlurEnabledInput.checked, scaleHeightLocked: scaleHeightInput.disabled };
        inputsToTrack.forEach(id => { const el = document.getElementById(id); if(el) state.values[id] = el.value; });
        const newStateStr = JSON.stringify(state);
        if (undoStack.length > 0 && undoStack[undoStack.length - 1] === newStateStr) return;
        undoStack.push(newStateStr);
        if (undoStack.length > UNDO_LIMIT) undoStack.shift(); 
        redoStack = []; updateHistoryButtons();
    }

    function applyState(stateStr) {
        isHistoryAction = true;
        const state = JSON.parse(stateStr);
        Object.keys(layerNames).forEach(k => {
            if (layerNames[k] !== state.names[k]) { renameLayerInPicturall(k, state.names[k]); }
            layerNames[k] = state.names[k];
        });
        inputsToTrack.forEach(id => { const el = document.getElementById(id); if(id !== 'iw' && id !== 'ih') el.value = state.values[id]; });
        updateScaleHeightLockUI(state.scaleHeightLocked !== false);
        for(let i=1; i<=MAX_LAYERS; i++) {
            const nameEl = document.getElementById(`layer-name-${i}`);
            if(nameEl) { nameEl.innerText = layerNames[i]; nameEl.title = layerNames[i]; }
        }
        if(state.layer) {
            currentSelectedLayer = state.layer;
            selectedLayers = new Set([state.layer]); selectionAnchorLayer = state.layer;
            updateLayerSelectionUI();
            previewLayerName.innerText = `[${layerNames[state.layer]}]`;
        }
        iwInput.value = state.values.iw; ihInput.value = state.values.ih;
        edgeBlurEnabledInput.checked = Boolean(state.edgeBlurEnabled);
        updateEdgeBlurUI(false);
        saveCurrentLayerState(); 
        applyPreset(false); 
        isHistoryAction = false;
        updateAll(); updateHistoryButtons();
    }

    function undo() { if (undoStack.length <= 1) return; redoStack.push(undoStack.pop()); applyState(undoStack[undoStack.length - 1]); }
    function redo() { if (redoStack.length === 0) return; const state = redoStack.pop(); undoStack.push(state); applyState(state); }
    function updateHistoryButtons() { undoBtn.disabled = undoStack.length <= 1; redoBtn.disabled = redoStack.length === 0; }
    undoBtn.onclick = undo; redoBtn.onclick = redo;
    resetBtn.onclick = () => {
        const targets = [...selectedLayers];
        targets.forEach(layer => {
            const defaults = createDefaultLayerState();
            layerStates[layer] = defaults;
            sendToPicturall(makeLayerTransformPayload(layer, defaults));
        });
        loadLayerState(currentSelectedLayer);
        document.querySelectorAll(".snap-btn").forEach(b => b.classList.remove("active"));
        document.querySelector('.snap-btn[data-x="center"][data-y="center"]').classList.add("active");
        handleResolutionChange(false, false);
        saveCurrentLayerState();
        updateSurfaceButtonStates();
        renderMultiLayerPreview();
        captureState();
    };

    document.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT') { if (e.key === 'Enter') e.target.blur(); return; }
        if (e.ctrlKey && e.key === 'z') { e.preventDefault(); undo(); return; }
        if (e.ctrlKey && e.key === 'y') { e.preventDefault(); redo(); return; }
        const keyNum = parseInt(e.key);
        if (keyNum >= 1 && keyNum <= 9) { selectLayer(keyNum); } 
        else if (e.key === '0') { selectLayer(10); }
    });

    function beginLayerRename(layer) {
        const nameEl = document.getElementById(`layer-name-${layer}`);
        if (!nameEl || nameEl.querySelector('input')) return;
        const input = document.createElement('input');
        input.className = 'layer-name-input';
        input.type = 'text';
        input.value = layerNames[layer];
        input.maxLength = 80;
        input.setAttribute('aria-label', `${layer}번 레이어 이름`);
        nameEl.textContent = '';
        nameEl.appendChild(input);
        let finished = false;
        const finish = shouldSave => {
            if (finished) return;
            finished = true;
            const nextName = input.value.trim() || `Layer ${layer}`;
            const changed = shouldSave && nextName !== layerNames[layer];
            if (changed) layerNames[layer] = nextName;
            nameEl.textContent = layerNames[layer];
            nameEl.title = layerNames[layer];
            if (changed) {
                updateLayerSelectionUI();
                updateAll(false);
                captureState();
                renameLayerInPicturall(layer, layerNames[layer]);
            }
        };
        input.addEventListener('click', event => event.stopPropagation());
        input.addEventListener('dblclick', event => event.stopPropagation());
        input.addEventListener('keydown', event => {
            event.stopPropagation();
            if (event.key === 'Enter') { event.preventDefault(); finish(true); }
            else if (event.key === 'Escape') { event.preventDefault(); finish(false); }
        });
        input.addEventListener('blur', () => finish(true));
        input.focus();
        input.select();
    }

    for (let i = 1; i <= MAX_LAYERS; i++) {
        layerNames[i] = `Layer ${i}`; 
        layerStates[i] = createDefaultLayerState();
        const item = document.createElement("div");
        item.className = "layer-item" + (i === 1 ? " active primary" : "");
        item.id = `layer-item-${i}`;
        item.innerHTML = `<div class="layer-number">${i}</div><div class="layer-name" id="layer-name-${i}" title="${layerNames[i]}">${layerNames[i]}</div><div class="surface-buttons"><button class="surface-btn" type="button" data-role="main" title="메인으로 지정">메인</button><button class="surface-btn" type="button" data-role="floor" title="바닥 프리셋 적용">바닥</button><button class="surface-btn" type="button" data-role="ceiling" title="천장 프리셋 적용">천장</button></div>`;
        item.onclick = (event) => { selectLayer(i, true, event.ctrlKey || event.metaKey, event.shiftKey); };
        item.querySelectorAll('.surface-btn').forEach(button => button.addEventListener('click', event => {
            event.stopPropagation();
            const targets = selectedLayers.size > 1 && selectedLayers.has(i) ? [...selectedLayers] : [i];
            targets.forEach(layer => applySurfacePresetToLayer(layer, button.dataset.role));
        }));
        item.querySelectorAll('.surface-btn').forEach(button => button.addEventListener('dblclick', event => event.stopPropagation()));
        item.ondblclick = event => {
            if (event.target.closest('.surface-buttons')) return;
            event.preventDefault();
            beginLayerRename(i);
        };
        layerList.appendChild(item);
    }

    function updateLayerSelectionUI() {
        document.querySelectorAll('.layer-item').forEach(item => {
            const num = Number(item.id.replace('layer-item-', ''));
            item.classList.toggle('active', selectedLayers.has(num));
            item.classList.toggle('primary', num === currentSelectedLayer);
        });
        const extra = selectedLayers.size > 1 ? ` +${selectedLayers.size - 1}` : '';
        previewLayerName.innerText = `[${layerNames[currentSelectedLayer]}]${extra}`;
        updatePrimarySourceTextVisibility();
        updateSurfaceButtonStates();
    }

    function updateSurfaceButtonStates() {
        document.querySelectorAll('.layer-item').forEach(item => {
            const layer = Number(item.id.replace('layer-item-', ''));
            const role = layerStates[layer]?.surfaceRole || 'main';
            item.querySelectorAll('.surface-btn').forEach(button => button.classList.toggle('active', button.dataset.role === role));
        });
        const role = layerStates[currentSelectedLayer]?.surfaceRole || 'main';
        const labels = { main: '메인', floor: '바닥', ceiling: '천장' };
        document.getElementById('snapTitle').textContent = `스냅 · ${labels[role]}`;
    }

    function applySurfacePresetToLayer(layer, role) {
        const currentRole = layerStates[layer]?.surfaceRole || 'main';
        // 이미 메인인 레이어에서는 오래된 웹 좌표를 서버로 재전송하지 않는다.
        if (currentRole === role && role === 'main') {
            updateSurfaceButtonStates();
            return;
        }
        if (layer === currentSelectedLayer) saveCurrentLayerState();
        const state = { ...layerStates[layer] };
        if (role === 'main') {
            const main = state.mainTransform;
            Object.assign(state, main || getMainTransformSnapshot(createDefaultLayerState()));
            state.surfaceRole = 'main';
        } else {
            const preset = SURFACE_PRESETS[role];
            if (!preset) return;
            if ((state.surfaceRole || 'main') === 'main') {
                state.mainTransform = getMainTransformSnapshot(state);
            }
            const wallW = Number(state.lw) || Number(lwInput.value), wallH = Number(state.lh) || Number(lhInput.value);
            state.iw = String(preset.iw); state.ih = String(preset.ih);
            state.scaleValue = preset.scale.toFixed(6); state.scaleHeight = '1.000000'; state.scaleHeightLocked = true;
            state.rotationValue = '0';
            state.pixelX = String(Number((wallW / 2 + preset.x * BASE_WIDTH).toFixed(3)));
            state.pixelY = String(Number((wallH / 2 - preset.y * BASE_WIDTH).toFixed(3)));
            state.surfaceRole = role;
        }
        layerStates[layer] = state;
        if (layer === currentSelectedLayer) document.querySelectorAll('.snap-btn').forEach(button => button.classList.remove('active'));
        const wallW = Number(state.lw), wallH = Number(state.lh);
        sendToPicturall({
            layer,
            x: role === 'main' ? ((Number(state.pixelX) - wallW / 2) / BASE_WIDTH).toFixed(6) : SURFACE_PRESETS[role].x.toFixed(6),
            y: role === 'main' ? ((wallH / 2 - Number(state.pixelY)) / BASE_WIDTH).toFixed(6) : SURFACE_PRESETS[role].y.toFixed(6),
            scale: state.scaleValue, scale_h: state.scaleHeight, rotation: state.rotationValue,
            edge_blur: Boolean(state.edgeBlurEnabled), edge_blur_strength: state.edgeBlurStrength || '20', surface: role
        });
        if (layer === currentSelectedLayer) { loadLayerState(layer); handleResolutionChange(false, false); captureState(); }
        updateSurfaceButtonStates(); renderMultiLayerPreview();
    }

    function selectLayer(num, shouldCapture = true, additive = false, range = false) {
        if (!additive && !range && currentSelectedLayer === num && selectedLayers.size === 1) return;
        saveCurrentLayerState();
        if (range) {
            const start = Math.min(selectionAnchorLayer, num), end = Math.max(selectionAnchorLayer, num);
            selectedLayers = new Set(Array.from({ length: end - start + 1 }, (_, index) => start + index));
            currentSelectedLayer = num;
        } else if (additive) {
            if (selectedLayers.has(num)) {
                if (selectedLayers.size > 1) {
                    selectedLayers.delete(num);
                    if (currentSelectedLayer === num) currentSelectedLayer = [...selectedLayers][0];
                }
            } else {
                selectedLayers.add(num); currentSelectedLayer = num;
            }
            selectionAnchorLayer = num;
        } else {
            selectedLayers = new Set([num]); currentSelectedLayer = num; selectionAnchorLayer = num;
        }
        updateLayerSelectionUI();
        loadLayerState(currentSelectedLayer);
        // 선택 및 다중 선택은 UI만 바꾸고 서버에는 값을 보내지 않는다.
        handleResolutionChange(false, false);
        if(shouldCapture) captureState();
    }

    let sendTimeout = null;
    let multiSendTimeout = null;
    function triggerSend() {
        if(sendTimeout) clearTimeout(sendTimeout);
        const payload = {
            layer: currentSelectedLayer,
            x: document.getElementById("posX_result").innerText,
            y: document.getElementById("posY_result").innerText,
            scale: document.getElementById("scaleValue").value,
            scale_h: scaleHeightInput.disabled ? "1.000000" : scaleHeightInput.value,
            rotation: document.getElementById("rotationValue").value,
            edge_blur: edgeBlurEnabledInput.checked,
            edge_blur_strength: edgeBlurStrengthInput.value,
            surface: layerStates[currentSelectedLayer]?.surfaceRole || 'main'
        };
        sendTimeout = setTimeout(() => sendToPicturall(payload), 50); 
    }

    function makeLayerTransformPayload(layer, state) {
        const wallW = Number(state.lw) || Number(lwInput.value), wallH = Number(state.lh) || Number(lhInput.value);
        return {
            layer,
            x: ((Number(state.pixelX) - wallW / 2) / BASE_WIDTH).toFixed(6),
            y: ((wallH / 2 - Number(state.pixelY)) / BASE_WIDTH).toFixed(6),
            scale: state.scaleValue,
            scale_h: state.scaleHeightLocked === false ? state.scaleHeight : '1.000000',
            rotation: state.rotationValue || '0',
            edge_blur: Boolean(state.edgeBlurEnabled),
            edge_blur_strength: state.edgeBlurStrength || '20',
            surface: state.surfaceRole || 'main'
        };
    }

    function syncSelectedTransformsFromPrimary() {
        if (selectedLayers.size <= 1) return;
        const before = layerStates[currentSelectedLayer] || createDefaultLayerState();
        const requested = {
            ...before,
            iw: iwInput.value,
            ih: ihInput.value,
            lw: lwInput.value,
            lh: lhInput.value,
            ledPreset: presetSelect.value,
            scaleValue: scaleInput.value,
            scaleHeight: scaleHeightInput.disabled ? '1.000000' : scaleHeightInput.value,
            scaleHeightLocked: scaleHeightInput.disabled,
            rotationValue: rotationInput.value,
            pixelX: pixelXInput.value,
            pixelY: pixelYInput.value,
            edgeBlurEnabled: edgeBlurEnabledInput.checked,
            edgeBlurStrength: edgeBlurStrengthInput.value
        };
        const rawScaleRatio = (Number(before.scaleValue) > 0) ? Number(requested.scaleValue) / Number(before.scaleValue) : 1;
        const scaleRatio = Number.isFinite(rawScaleRatio) && rawScaleRatio > 0 ? rawScaleRatio : 1;
        const rawHeightRatio = (Number(before.scaleHeight) > 0) ? Number(requested.scaleHeight) / Number(before.scaleHeight) : 1;
        const heightRatio = Number.isFinite(rawHeightRatio) && rawHeightRatio > 0 ? rawHeightRatio : 1;
        const rotationDelta = Number(requested.rotationValue) - Number(before.rotationValue);
        const radians = rotationDelta * Math.PI / 180;
        const cos = Math.cos(radians), sin = Math.sin(radians);
        const primaryWallH = Number(before.lh) || Number(lhInput.value);
        const beforePrimaryPreview = getPreviewCenter(before, primaryWallH);
        const requestedPrimaryPreview = getPreviewCenter({ ...before, pixelX: requested.pixelX, pixelY: requested.pixelY }, primaryWallH);
        const groupResize = transformGesture?.type === 'resize';
        const translateX = groupResize ? 0 : requestedPrimaryPreview.x - beforePrimaryPreview.x;
        const translateY = groupResize ? 0 : requestedPrimaryPreview.y - beforePrimaryPreview.y;
        const payloads = [];
        selectedLayers.forEach(layer => {
            const original = layer === currentSelectedLayer ? before : layerStates[layer];
            const state = { ...original };
            const wallW = Number(state.lw) || Number(lwInput.value), wallH = Number(state.lh) || Number(lhInput.value);
            const role = state.surfaceRole || 'main';
            const bounds = getSurfaceBoundsForRole(role, wallW, wallH);
            const pivotX = (bounds.left + bounds.right) / 2, pivotY = (bounds.top + bounds.bottom) / 2;
            const preview = getPreviewCenter(state, wallH);
            const localX = (preview.x - pivotX) * scaleRatio, localY = (preview.y - pivotY) * scaleRatio;
            const transformedX = pivotX + localX * cos - localY * sin + translateX;
            const transformedY = pivotY + localX * sin + localY * cos + translateY;
            state.pixelX = String(Number(transformedX.toFixed(3)));
            state.pixelY = String(Number(previewYToServerY(transformedY, state, wallH).toFixed(3)));
            state.iw = requested.iw;
            state.ih = requested.ih;
            state.lw = requested.lw;
            state.lh = requested.lh;
            state.ledPreset = requested.ledPreset;
            state.scaleValue = layer === currentSelectedLayer ? requested.scaleValue : (Number(state.scaleValue) * scaleRatio).toFixed(6);
            state.scaleHeight = scaleHeightInput.disabled ? '1.000000' : (layer === currentSelectedLayer ? requested.scaleHeight : (Number(state.scaleHeight) * heightRatio).toFixed(6));
            state.scaleHeightLocked = scaleHeightInput.disabled;
            const nextRotation = layer === currentSelectedLayer ? Number(requested.rotationValue) : Number(state.rotationValue) + rotationDelta;
            state.rotationValue = ((((nextRotation % 360) + 360) % 360)).toFixed(3);
            state.edgeBlurEnabled = edgeBlurEnabledInput.checked;
            state.edgeBlurStrength = edgeBlurStrengthInput.value;
            if ((state.surfaceRole || 'main') === 'main') state.mainTransform = getMainTransformSnapshot(state);
            layerStates[layer] = state;
            if (layer === currentSelectedLayer) {
                pixelXInput.value = state.pixelX;
                pixelYInput.value = state.pixelY;
            } else payloads.push(makeLayerTransformPayload(layer, state));
        });
        if (multiSendTimeout) clearTimeout(multiSendTimeout);
        multiSendTimeout = setTimeout(() => payloads.forEach(sendToPicturall), 50);
    }

