    function getSurfaceBoundsForRole(role, wallW, wallH) {
        if (role === 'main') return { left: 0, top: 0, right: wallW, bottom: wallH };
        const preset = SURFACE_PRESETS[role];
        const width = preset.scale * BASE_WIDTH;
        const height = width * preset.ih / preset.iw;
        const centerX = wallW / 2 + preset.x * BASE_WIDTH;
        if (role === 'ceiling') return { left: centerX - width / 2, top: -height, right: centerX + width / 2, bottom: 0 };
        return { left: centerX - width / 2, top: wallH, right: centerX + width / 2, bottom: wallH + height };
    }

    function getSurfaceSnapBounds() {
        const wallW = Number(lwInput.value), wallH = Number(lhInput.value);
        const role = layerStates[currentSelectedLayer]?.surfaceRole || 'main';
        return getSurfaceBoundsForRole(role, wallW, wallH);
    }

    // 서버의 실제 좌표는 유지하고, 프리뷰에서만 천장/바닥 가이드를 메인에 붙여 보이게 한다.
    function getSurfacePreviewOffsetY(state, wallH) {
        const role = state?.surfaceRole || 'main';
        const preset = SURFACE_PRESETS[role];
        if (!preset) return 0;
        const guideH = preset.scale * BASE_WIDTH * preset.ih / preset.iw;
        const serverPresetY = wallH / 2 - preset.y * BASE_WIDTH;
        const attachedGuideY = role === 'ceiling' ? -guideH / 2 : wallH + guideH / 2;
        return attachedGuideY - serverPresetY;
    }

    function getPreviewCenter(state, wallH) {
        return {
            x: Number(state.pixelX),
            y: Number(state.pixelY) + getSurfacePreviewOffsetY(state, wallH)
        };
    }

    function previewYToServerY(previewY, state, wallH) {
        return previewY - getSurfacePreviewOffsetY(state, wallH);
    }

    function getSelectedGroupPreviewBounds() {
        if (selectedLayers.size <= 1) return null;
        const wallH = Number(lhInput.value) || 1;
        const primaryRole = layerStates[currentSelectedLayer]?.surfaceRole || 'main';
        const states = [...selectedLayers].map(layer => {
            const saved = layerStates[layer];
            if (!saved || (saved.surfaceRole || 'main') !== primaryRole) return null;
            return layer === currentSelectedLayer ? {
                ...saved,
                iw: iwInput.value, ih: ihInput.value,
                scaleValue: scaleInput.value, scaleHeight: scaleHeightInput.value,
                rotationValue: rotationInput.value, pixelX: pixelXInput.value, pixelY: pixelYInput.value
            } : saved;
        });
        if (states.some(state => !state)) return null;
        let left = Infinity, top = Infinity, right = -Infinity, bottom = -Infinity;
        states.forEach(state => {
            const center = getPreviewCenter(state, wallH);
            const width = Number(state.scaleValue) * BASE_WIDTH;
            const height = width * Number(state.scaleHeight || 1) * (Number(state.ih) / Number(state.iw));
            const radians = Number(state.rotationValue || 0) * Math.PI / 180;
            const halfW = Math.abs(Math.cos(radians)) * width / 2 + Math.abs(Math.sin(radians)) * height / 2;
            const halfH = Math.abs(Math.sin(radians)) * width / 2 + Math.abs(Math.cos(radians)) * height / 2;
            left = Math.min(left, center.x - halfW); right = Math.max(right, center.x + halfW);
            top = Math.min(top, center.y - halfH); bottom = Math.max(bottom, center.y + halfH);
        });
        return { left, top, right, bottom };
    }

    function setSnapPosition(btn) {
        const S = parseFloat(scaleInput.value) || 1, Sh = parseFloat(scaleHeightInput.value) || 1;
        const bW = S * BASE_WIDTH, bH = S * Sh * BASE_WIDTH * (Number(ihInput.value)/Number(iwInput.value));
        const bounds = getSurfaceSnapBounds();
        const state = { ...layerStates[currentSelectedLayer], pixelX: pixelXInput.value, pixelY: pixelYInput.value };
        const groupBounds = getSelectedGroupPreviewBounds();
        let tx, ty;
        if (groupBounds) {
            const currentCenter = getPreviewCenter(state, Number(lhInput.value));
            let dx = (bounds.left + bounds.right) / 2 - (groupBounds.left + groupBounds.right) / 2;
            let dy = (bounds.top + bounds.bottom) / 2 - (groupBounds.top + groupBounds.bottom) / 2;
            if (btn.dataset.x === 'left') dx = bounds.left - groupBounds.left;
            else if (btn.dataset.x === 'right') dx = bounds.right - groupBounds.right;
            if (btn.dataset.y === 'top') dy = bounds.top - groupBounds.top;
            else if (btn.dataset.y === 'bottom') dy = bounds.bottom - groupBounds.bottom;
            tx = currentCenter.x + dx; ty = currentCenter.y + dy;
        } else {
            tx = (bounds.left + bounds.right) / 2; ty = (bounds.top + bounds.bottom) / 2;
            if(btn.dataset.x === 'left') tx = bounds.left + bW/2; else if(btn.dataset.x === 'right') tx = bounds.right - bW/2;
            if(btn.dataset.y === 'top') ty = bounds.top + bH/2; else if(btn.dataset.y === 'bottom') ty = bounds.bottom - bH/2;
        }
        pixelXInput.value = Number(tx.toFixed(3));
        pixelYInput.value = Number(previewYToServerY(ty, state, Number(lhInput.value)).toFixed(3));
    }

    function handleResolutionChange(shouldSend = true, shouldApplySnap = true) {
        const iw = Number(iwInput.value) || 1, ih = Number(ihInput.value) || 1;
        const lw = Number(lwInput.value) || 1, lh = Number(lhInput.value) || 1;
        const g = gcd(iw, ih); document.getElementById("ratioValue").innerText = `${iw/g}:${ih/g}`;
        checkScanAppliedState();
        const sW = (lw / BASE_WIDTH).toFixed(6);
        const sH = (Number(sW) * lh / (lw * ih / iw)).toFixed(6);
        const sO = (iw / BASE_WIDTH).toFixed(6);
        document.getElementById("baseScaleResult").innerHTML = `
            <div class="scale-item" onclick="applyScale('${sW}', this)"><span class="scale-label">가로 채우기</span><span class="val">${sW}</span></div>
            <div class="scale-item" onclick="applyScale('${sH}', this)"><span class="scale-label">세로 채우기</span><span class="val">${sH}</span></div>
            <div class="scale-item" onclick="applyScale('${sO}', this)"><span class="scale-label">정사이즈 (1:1)</span><span class="val">${sO}</span></div>`;
        elVisualizer.style.aspectRatio = `${lw * EDITOR_SCALE_X}/${lh * EDITOR_SCALE_Y}`;
        sourceResLabel.innerText = `${iw}x${ih}`;
        if (!scaleInput.value) {
            scaleInput.value = sO;
            pixelXInput.value = Math.round(lw / 2); pixelYInput.value = Math.round(lh / 2);
            document.querySelectorAll(".snap-btn").forEach(b => b.classList.remove("active"));
            document.querySelector('.snap-btn[data-x="center"][data-y="center"]').classList.add("active");
            updateAll(shouldSend);
        } else {
            const activeSnap = document.querySelector(".snap-btn.active");
            if (activeSnap && shouldApplySnap) setSnapPosition(activeSnap);
            updateAll(shouldSend);
        }
    }

    function updateScaleHeightLockUI(locked) {
        const field = document.getElementById('scaleHeightField');
