    function applyAutoSplit() {
        syncSplitDraftFromUI();
        const assigned = autoSplitDraft.map((slot, index) => ({ ...slot, index })).filter(slot => slot.layer !== '');
        const layers = assigned.map(slot => Number(slot.layer));
        if (!assigned.length) { splitError.textContent = '레이어 번호를 하나 이상 입력해주세요.'; return; }
        if (layers.some(layer => !Number.isInteger(layer) || layer < 1 || layer > MAX_LAYERS)) { splitError.textContent = `레이어 번호는 1~${MAX_LAYERS}만 사용할 수 있습니다.`; return; }
        if (new Set(layers).size !== layers.length) { splitError.textContent = '같은 레이어를 여러 영역에 넣을 수 없습니다.'; return; }
        if (assigned.some(slot => !(Number(slot.scale) > 0) || !Number.isFinite(Number(slot.offsetX)) || !Number.isFinite(Number(slot.offsetY)))) {
            splitError.textContent = '배율과 이동값을 확인해주세요.'; return;
        }
        const layout = SPLIT_LAYOUTS[autoSplitCount];
        const wallW = Number(lwInput.value), wallH = Number(lhInput.value);
        const bounds = getSurfaceBoundsForRole(autoSplitSurface, wallW, wallH);
        const cellW = (bounds.right - bounds.left) / layout.cols, cellH = (bounds.bottom - bounds.top) / layout.rows;
        const prepared = assigned.map(slot => {
            const layer = Number(slot.layer), state = { ...layerStates[layer] };
            const previousRole = state.surfaceRole || 'main';
            if (autoSplitSurface === 'main' && previousRole !== 'main' && state.mainTransform) Object.assign(state, state.mainTransform);
            if (autoSplitSurface !== 'main') {
                if (previousRole === 'main') state.mainTransform = getMainTransformSnapshot(state);
                state.iw = String(SURFACE_PRESETS[autoSplitSurface].iw);
                state.ih = String(SURFACE_PRESETS[autoSplitSurface].ih);
                state.rotationValue = '0';
            }
            return { slot, layer, state };
        });
        const referenceRatio = Number(prepared[0].state.ih) / Number(prepared[0].state.iw);
        const baseScale = Math.min(cellW / BASE_WIDTH, cellH / (BASE_WIDTH * referenceRatio));
        const tileW = baseScale * BASE_WIDTH, tileH = tileW * referenceRatio;
        const groupLeft = bounds.left + ((bounds.right - bounds.left) - tileW * layout.cols) / 2;
        const groupTop = bounds.top + ((bounds.bottom - bounds.top) - tileH * layout.rows) / 2;
        prepared.forEach(({ slot, layer, state }) => {
            const col = slot.index % layout.cols, row = Math.floor(slot.index / layout.cols);
            const multiplier = Number(slot.scale), sourceRatio = Number(state.ih) / Number(state.iw);
            const previewX = groupLeft + (col + .5) * tileW + Number(slot.offsetX);
            const previewY = groupTop + (row + .5) * tileH + Number(slot.offsetY);
            const sourceScale = Math.min(tileW / BASE_WIDTH, tileH / (BASE_WIDTH * sourceRatio));
            state.scaleValue = (sourceScale * multiplier).toFixed(6);
            state.scaleHeight = "1.000000";
            state.scaleHeightLocked = true;
            state.surfaceRole = autoSplitSurface;
            state.pixelX = String(Number(previewX.toFixed(3)));
            state.pixelY = String(Number(previewYToServerY(previewY, state, wallH).toFixed(3)));
            state.ledPreset = presetSelect.value; state.lw = String(wallW); state.lh = String(wallH);
            if (autoSplitSurface === 'main') state.mainTransform = getMainTransformSnapshot(state);
            layerStates[layer] = state;
            sendToPicturall({
                layer, x: ((Number(state.pixelX) - wallW / 2) / BASE_WIDTH).toFixed(6), y: ((wallH / 2 - Number(state.pixelY)) / BASE_WIDTH).toFixed(6),
                scale: state.scaleValue, scale_h: state.scaleHeight, rotation: state.rotationValue || '0',
                edge_blur: Boolean(state.edgeBlurEnabled), edge_blur_strength: state.edgeBlurStrength || '20', surface: autoSplitSurface
            });
        });
        document.querySelectorAll(".snap-btn").forEach(btn => btn.classList.remove("active"));
        loadLayerState(currentSelectedLayer); handleResolutionChange(false, false); captureState(); closeAutoSplit();
    }

