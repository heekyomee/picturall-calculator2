    function updateAll(shouldSend = true) {
        const lw = Number(lwInput.value), lh = Number(lhInput.value), iw = Number(iwInput.value), ih = Number(ihInput.value);
        if (shouldSend) syncSelectedTransformsFromPrimary();
        const px = Number(pixelXInput.value), py = Number(pixelYInput.value);
        const S = parseFloat(scaleInput.value) || 1, Sh = parseFloat(scaleHeightInput.value) || 1;
        const nX = (px - lw / 2) / BASE_WIDTH;
        const nY = (lh / 2 - py) / BASE_WIDTH;
        document.getElementById("posX_result").innerText = nX.toFixed(6);
        document.getElementById("posY_result").innerText = nY.toFixed(6);
        const bW = S * BASE_WIDTH, bH = S * Sh * BASE_WIDTH * (ih / iw);
        const editorW = lw * EDITOR_SCALE_X, editorH = lh * EDITOR_SCALE_Y;
        const previewCenter = getPreviewCenter({ ...layerStates[currentSelectedLayer], pixelX: px, pixelY: py }, lh);
        const wP = (bW / editorW) * 100, hP = (bH / editorH) * 100;
        elSourceBox.style.width = `${wP}%`; elSourceBox.style.height = `${hP}%`;
        elSourceBox.style.left = `${((previewCenter.x + lw * EDITOR_MARGIN_X)/editorW)*100 - wP/2}%`;
        elSourceBox.style.top = `${((previewCenter.y + lh * EDITOR_MARGIN_Y)/editorH)*100 - hP/2}%`;
        const rotation = Number(rotationInput.value) || 0;
        elSourceBox.style.transform = `rotate(${rotation}deg)`;
        const blurStrength = edgeBlurEnabledInput.checked ? Number(edgeBlurStrengthInput.value) || 0 : 0;
        edgeBlurPreview.style.boxShadow = blurStrength ? `inset 0 0 ${Math.max(3, blurStrength * 0.22)}px ${Math.max(1, blurStrength * 0.05)}px rgba(241,245,249,.88)` : 'none';
        document.querySelectorAll('.rotation-preset').forEach(btn => btn.classList.toggle('active', Number(btn.dataset.rotation) === rotation));
        sourceResLabel.innerText = `${iw} X ${ih}`; calcResLabel.innerText = `(${Math.round(bW)} X ${Math.round(bH)})`;
        updatePrimarySourceTextVisibility();
        updateSurfaceGuides(lw, lh, editorW, editorH);
